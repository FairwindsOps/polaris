{
  "author": "",
  "bugs": {
    "url": "https://github.com/FairwindsOps/insights-docs/issues"
  },
  "description": "A repository with a VitePress template for Fairwinds projects",
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "6.4.5"
  },
  "directories": {
    "doc": "docs"
  },
  "homepage": "https://github.com/FairwindsOps/insights-docs#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "main": "index.js",
  "name": "fairwinds-docs-template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FairwindsOps/insights-docs.git"
  },
  "scripts": {
    "build": "node .vitepress/s3-dir-index.mjs --build-site",
    "build:metadata": "node .vitepress/s3-dir-index.mjs --build-readme",
    "build:readme": "node .vitepress/s3-dir-index.mjs --build-readme",
    "check-links": "npm run build",
    "serve": "npm run build:readme && vitepress dev --port 3003",
    "test": "node .vitepress/s3-dir-index.mjs --self-check && node .vitepress/config.mjs --self-check"
  },
  "version": "0.0.1"
}

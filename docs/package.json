{
  "author": "",
  "bugs": {
    "url": "https://github.com/FairwindsOps/insights-docs/issues"
  },
  "description": "Documentation site for Fairwinds Polaris",
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "6.4.5"
  },
  "directories": {
    "doc": "docs"
  },
  "homepage": "https://github.com/FairwindsOps/insights-docs#readme",
  "license": "MIT",
  "main": "index.js",
  "name": "fairwinds-docs-template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FairwindsOps/insights-docs.git"
  },
  "scripts": {
    "build": "npm run build:readme && npm run build:docs",
    "build:docs": "vitepress build",
    "build:metadata": "cat main-metadata.md > index.md || true",
    "build:readme": "npm run build:metadata && cat ../README.md | grep -v 'ocumentation' | sed -E 's#https://[A-Za-z0-9.-]+\\.docs\\.fairwinds\\.com##g' >> index.md",
    "serve": "npm run build:readme && vitepress dev --port 3003"
  },
  "version": "0.0.1"
}

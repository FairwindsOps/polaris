## DO NOT EDIT - Managed by Terraform
version: 2.1

orbs:
  rok8s: fairwinds/rok8s-scripts@${rok8s_orb}
%{ if docs ~}
  oss-docs: fairwinds/oss-docs@${oss_docs_orb}
%{ endif ~}

references:
  install_vault_machine: &install_vault_machine
    run:
      name: install hashicorp vault
      command: |
        sudo apt-get update -y && sudo apt-get install -y curl unzip
        cd /tmp
        curl -LO https://releases.hashicorp.com/vault/${vault_version}/vault_${vault_version}_linux_amd64.zip
        echo '${vault_sha256}  vault_${vault_version}_linux_amd64.zip' | sha256sum -c
        unzip -o vault_${vault_version}_linux_amd64.zip
        sudo mv vault /usr/bin/vault
  setup_qemu_binfmt: &setup_qemu_binfmt
    run:
      name: Setup QEMU for multi-arch Docker builds
      command: |
        sudo apt-get update -y
        sudo apt-get install -y qemu-user-static binfmt-support
        docker buildx create --use || true
        docker buildx inspect --bootstrap
%{ if e2e ~}
  e2e_configuration: &e2e_configuration
    executor: golang-exec
    pre_script: ${e2e_pre}
    script: ${e2e_script}
    command_runner_image: ${ci_images}
    enable_docker_layer_caching: true
    store-test-results: /tmp/test-results
    attach-workspace: true
    requires:
      - test
      - snapshot
    filters:
      branches:
        only: /.*/
      tags:
        ignore: /.*/

executors:
  golang-exec:
    docker:
      - image: ${go_image}
%{ endif ~}

jobs:
  test:
    docker:
      - image: ${go_image}
    steps:
      - checkout
      - run:
          name: Go Mod Download
          command: go mod download && go mod verify
%{ if golangci ~}
      - run:
          name: golangci-lint
          command: |
            curl -fsSL -o golangci-lint.tar.gz https://github.com/golangci/golangci-lint/releases/download/v${golangci_version}/golangci-lint-${golangci_version}-linux-amd64.tar.gz
            echo '${golangci_sha256}  golangci-lint.tar.gz' | sha256sum -c
            tar -xzf golangci-lint.tar.gz
            mv golangci-lint-${golangci_version}-linux-amd64/golangci-lint "$(go env GOPATH)/bin/golangci-lint"
            golangci-lint run --timeout 5m
%{ endif ~}
      - run:
          name: test
          command: |
            go test -v -coverprofile=coverage.txt -covermode=atomic ${test_packages}
            go vet ./...
%{ if test_dashboard ~}
      - run:
          name: Test Dashboard
          command: ./test/dashboard_test.sh
%{ endif ~}
%{ if gotest_e2e_setup != "" ~}
      - run:
          name: e2e setup
          command: ${gotest_e2e_setup}
%{ endif ~}
%{ if gotest_e2e_packages != "" ~}
%{ if repo_vault ~}
      - *install_vault_machine
      - rok8s/get_vault_env:
          vault_path: repo/${project}/env
%{ endif ~}
      - run:
          name: e2e tests
          command: go test -v -tags e2e ${gotest_e2e_packages}
%{ endif ~}
%{ if docker_build ~}
  docker_build:
    docker:
      - image: ${go_image}
    steps:
      - checkout
      - setup_remote_docker:
          docker_layer_caching: true
      - run:
          name: Build Docker image
          command: docker build -t ${project}:test .
%{ endif ~}
  snapshot:
    machine:
      image: ${machine_image}
    resource_class: large
    steps:
      - checkout
      - *setup_qemu_binfmt
      - run:
          name: Run GoReleaser snapshot
          command: |
            docker run --rm \
              -v /var/run/docker.sock:/var/run/docker.sock \
              -v "$(pwd):/workspace" -w /workspace \
              -e CIRCLE_SHA1 \
              -e CIRCLE_BRANCH \
              -e CIRCLE_TAG \
              goreleaser/goreleaser:${goreleaser_version} release --snapshot --skip=sign
%{ if e2e ~}
      - run:
          name: Save snapshot amd64 image for e2e
          command: |
            mkdir -p /tmp/workspace/docker_save
            docker save us-docker.pkg.dev/fairwinds-ops/oss/${project}:$${CIRCLE_SHA1}-amd64 > /tmp/workspace/docker_save/${project}_$${CIRCLE_SHA1}-amd64.tar
      - persist_to_workspace:
          root: /tmp/workspace/
          paths:
            - docker_save
%{ endif ~}
      - store_artifacts:
          path: dist
          destination: snapshot
  release:
    machine:
      image: ${machine_image}
    resource_class: large
    shell: /bin/bash
    steps:
      - checkout
      - *install_vault_machine
      - rok8s/get_vault_env:
          vault_path: repo/global/env
%{ if repo_vault ~}
      - rok8s/get_vault_env:
          vault_path: repo/${project}/env
%{ endif ~}
      - run:
          name: docker login Google Artifact Registry
          command: |
            docker login -u _json_key -p "$(echo $GCP_ARTIFACTREADWRITE_JSON_KEY | base64 -d)" us-docker.pkg.dev
      - *setup_qemu_binfmt
      - run:
          name: Run GoReleaser release
          command: |
            export GORELEASER_CURRENT_TAG="$${CIRCLE_TAG}"
            docker run --rm \
              -v /var/run/docker.sock:/var/run/docker.sock \
              -v "$(pwd):/workspace" -w /workspace \
              -v "$${HOME}/.docker:/root/.docker" \
              -e GORELEASER_CURRENT_TAG \
              -e CIRCLE_TAG \
              -e CIRCLE_SHA1 \
              -e GO111MODULE=on \
              -e GITHUB_TOKEN \
              -e VAULT_ADDR \
              -e VAULT_TOKEN \
              goreleaser/goreleaser:${goreleaser_version} release

workflows:
  version: 2
  test_and_build:
    jobs:
      - test:
          filters:
            tags:
              ignore: /.*/
%{ if gotest_e2e_packages != "" ~}
          context: org-global
%{ endif ~}
%{ if docker_build ~}
      - docker_build:
          requires:
            - test
%{ endif ~}
      - snapshot:
          requires:
            - test
          filters:
            branches:
              only: /.*/
            tags:
              ignore: /.*/
%{ if e2e ~}
%{ for img in kind_images ~}
      - rok8s/kubernetes_e2e_tests:
          name: "${img.name}"
%{ if img.image != "" ~}
          kind_node_image: "${img.image}"
%{ endif ~}
          <<: *e2e_configuration
%{ endfor ~}
%{ endif ~}
  release:
    jobs:
      - test:
          filters:
            branches:
              ignore: /.*/
            tags:
              only: /.*/
%{ if gotest_e2e_packages != "" ~}
          context: org-global
%{ endif ~}
      - release:
          requires:
            - test
          context: org-global
          filters:
            branches:
              ignore: /.*/
            tags:
              only: /.*/
%{ if docs ~}
      - oss-docs/publish-docs:
          requires:
            - release
          repository: ${project}
          filters:
            branches:
              ignore: /.*/
            tags:
              only: /.*/
%{ endif ~}
